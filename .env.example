# ── OpenRouter LLM ──────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Google Calendar ──────────────────────────────────────────────────────────
# Crea credenciales OAuth2 en https://console.cloud.google.com/
# Scope requerido: https://www.googleapis.com/auth/calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# ID del calendario (email o "primary")
GOOGLE_CALENDAR_ID=primary
# Zona horaria del negocio (ej: America/Argentina/Buenos_Aires, Europe/Madrid)
BUSINESS_TIMEZONE=Europe/Madrid
# Horario de atención para que el bot no ofrezca huecos fuera de hora
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=20:00
# Duración por defecto de cada cita en minutos
APPOINTMENT_DURATION_MINUTES=60

# ── Auth dashboard ───────────────────────────────────────────────────────────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=cambia_esta_clave
SESSION_SECRET=cambia_este_secreto_largo_y_aleatorio
